# Build artifacts
build/
__pycache__/
*.pyc

# Everything under these output/ directories (meshes, Elmer mesh
# directories, .sif, .vtu, .result, json config, ...) is regenerated by
# running the geometry/elmer/macros scripts in order -- see README.md.
# Only the check-image PNGs are kept in git, as verification evidence.
geometry/output/*
!geometry/output/*.png
macros/output/*
!macros/output/*.png
visualization/output/*
!visualization/output/*.png
